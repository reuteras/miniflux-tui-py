{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "semanticCommits": "enabled",
    "commitMessagePrefix": "chore(deps):",
    "prCreation": "auto",
    "prConcurrentLimit": 2,
    "github-actions": {
        "enabled": true,
        "automerge": false,
        "pinDigests": true,
        "major": {
            "enabled": true
        }
    },
    "npm": {
        "enabled": false
    },
    "schedule": [
        "after 10pm on monday"
    ],
    "packageRules": [
        {
            "description": "Security updates: run immediately/daily",
            "matchUpdateTypes": [
                "patch"
            ],
            "matchDatasources": [
                "docker",
                "github-actions"
            ],
            "schedule": [
                "at any time"
            ],
            "groupName": "security-updates"
        },
        {
            "description": "Major version updates: weekly review, no automerge",
            "matchUpdateTypes": [
                "major"
            ],
            "matchDatasources": [
                "docker",
                "github-actions"
            ],
            "automerge": false,
            "schedule": [
                "after 10pm on sunday"
            ],
            "groupName": "major-version-updates"
        },
        {
            "matchCategories": [
                "python"
            ],
            "enabled": false
        },
        {
            "matchDatasources": [
                "github-tags"
            ],
            "allowedVersions": "<=2.0.0",
            "matchPackageNames": [
                "/slsa-framework/slsa-github-generator/"
            ]
        }
    ]
}
