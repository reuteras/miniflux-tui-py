{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "semanticCommits": "enabled",
    "commitMessagePrefix": "chore(deps):",
    "prCreation": "auto",
    "prConcurrentLimit": 2,
    "github-actions": {
        "enabled": true,
        "automerge": false,
        "pinDigests": true,
        "major": {
            "enabled": false
        }
    },
    "npm": {
        "enabled": false
    },
    "schedule": [
        "after 10pm on monday"
    ],
    "packageRules": [
        {
            "matchCategories": [
                "python"
            ],
            "enabled": false
        },
        {
            "matchDatasources": [
                "github-tags"
            ],
            "allowedVersions": "<=2.0.0",
            "matchPackageNames": [
                "/slsa-framework/slsa-github-generator/"
            ]
        }
    ]
}
