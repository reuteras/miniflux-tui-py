{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "github>reuteras/github-renovate-config"
    ],
    "semanticCommits": "enabled",
    "commitMessagePrefix": "chore(deps):",
    "npm": {
        "enabled": false
    },
    "vulnerabilityAlerts": {
        "enabled": true
    },
    "prConcurrentLimit": 10,
    "packageRules": [
        {
            "description": "Disable npm updates (not used in this project)",
            "matchManagers": [
                "npm"
            ],
            "enabled": false
        },
        {
            "description": "All updates: create PRs at any time without schedules",
            "matchUpdateTypes": [
                "patch",
                "minor",
                "digest",
                "pinDigest"
            ],
            "schedule": [
                "at any time"
            ]
        },
        {
            "description": "Major version updates for github-actions: allow creation but automerge disabled",
            "matchManagers": [
                "github-actions"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "automerge": false,
            "schedule": [
                "at any time"
            ]
        },
        {
            "description": "Major version updates for docker: allow creation but automerge disabled",
            "matchDatasources": [
                "docker"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "automerge": false,
            "schedule": [
                "at any time"
            ]
        },
        {
            "description": "Restrict slsa-github-generator to v1.x only",
            "matchDatasources": [
                "github-tags"
            ],
            "allowedVersions": "<=2.0.0",
            "matchPackageNames": [
                "/slsa-framework/slsa-github-generator/"
            ]
        },
        {
            "description": "Skip trivy-action updates due to lookup failures",
            "matchPackageNames": [
                "aquasecurity/trivy-action"
            ],
            "enabled": false
        }
    ]
}
