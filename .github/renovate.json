{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended"],
    "enabledManagers": ["custom.regex"],
    "minimumReleaseAge": "7 days",
    "customManagers": [
        {
            "customType": "regex",
            "description": "Release binaries downloaded with gh release download in workflows",
            "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\n]+)\\n\\s+\\w+: (?<currentValue>v[0-9][0-9.]*)"
            ],
            "versioningTemplate": "semver"
        }
    ]
}
