{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:base"],
    "enabledManagers": ["regex"],
    "customManagers": [
        {
            "customType": "regex",
            "fileMatch": ["\\.github/workflows/.*\\.ya?ml$"],
                "matchStrings": [
                    "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\n]+)\\n\\s+\\w+: (?<currentValue>v[0-9][0-9.]*)"
                ],
            "versioningTemplate": "semver"
        }
    ]
}
