{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "description": "Renovate configuration for automated dependency and action updates",
    "semanticCommits": "enabled",
    "commitMessagePrefix": "chore(deps):",
    "prCreation": "auto",
    "prConcurrentLimit": 2,
    "github-actions": {
        "enabled": true,
        "automerge": false,
        "pinDigests": true,
        "major": {
            "enabled": false
        }
    },
    "npm": {
        "enabled": false
    },
    "groupName": "GitHub Actions",
    "groupSlug": "github-actions",
    "schedule": [
        "after 10pm on monday"
    ],
    "packageRules": [
        {
            "matchCategories": ["python"],
            "enabled": false
        },
        {
            "matchCategories": ["docker"],
            "enabled": false
        }
    ]
}
